PORT=3000
CORS_ORIGINS=http://localhost:5173
# Firebase Admin: use ONE of the following
# 1) Path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# 2) Or inline values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Required: https://<project>-default-rtdb.<region>.firebasedatabase.app
FIREBASE_DATABASE_URL=
