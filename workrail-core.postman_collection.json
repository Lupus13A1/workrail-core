{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "workrail-core API",
    "description": "Postman Collection สำหรับทดสอบ API ของ workrail-core (NestJS + Firebase Auth & Realtime Database)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{firebaseIdToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "firebaseIdToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "serverId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "ตรวจสอบสถานะเซิร์ฟเวอร์ (Public ไม่ต้องใช้ Token)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Current Token Identity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "ดึงข้อมูลตัวตนจาก Firebase ID Token ที่ส่งมา"
          },
          "response": []
        },
        {
          "name": "Set User Role (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"<target-user-uid>\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "role"
              ]
            },
            "description": "กำหนด role ('admin' หรือ 'user') ให้ผู้ใช้ (ต้องใช้สิทธิ์ admin)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get or Create My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "ดึงข้อมูลโปรไฟล์ผู้ใช้จาก RTDB (ถ้ายังไม่มีจะสร้างให้อัตโนมัติ)"
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Thanet Chankhua\",\n  \"photoURL\": \"https://example.com/avatar.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "อัปเดต displayName และ/หรือ photoURL ของตัวเองใน RTDB"
          },
          "response": []
        }
      ]
    },
    {
      "name": "MCP Servers",
      "item": [
        {
          "name": "Create MCP Server (HTTP / SSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "    pm.collectionVariables.set(\"serverId\", json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"my-http-server\",\n  \"description\": \"Remote MCP server via streamable-http\",\n  \"transport\": \"streamable-http\",\n  \"url\": \"http://localhost:4000/mcp\",\n  \"headers\": {\n    \"X-Api-Key\": \"example-key\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "servers"
              ]
            },
            "description": "สร้าง MCP Server แบบ streamable-http หรือ sse"
          },
          "response": []
        },
        {
          "name": "Create MCP Server (Stdio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "    pm.collectionVariables.set(\"serverId\", json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"local-stdio-server\",\n  \"description\": \"Local MCP server via stdio\",\n  \"transport\": \"stdio\",\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"@modelcontextprotocol/server-everything\"],\n  \"env\": {\n    \"NODE_ENV\": \"production\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "servers"
              ]
            },
            "description": "สร้าง MCP Server แบบ stdio"
          },
          "response": []
        },
        {
          "name": "List My MCP Servers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mcp/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "servers"
              ]
            },
            "description": "แสดงรายการ MCP Server ทั้งหมดของผู้ใช้"
          },
          "response": []
        },
        {
          "name": "Get MCP Server by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mcp/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "servers",
                "{{serverId}}"
              ]
            },
            "description": "ดึงรายละเอียด MCP Server ตาม ID"
          },
          "response": []
        },
        {
          "name": "Update MCP Server",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"updated-server-name\",\n  \"description\": \"Updated description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "servers",
                "{{serverId}}"
              ]
            },
            "description": "แก้ไขข้อมูล MCP Server ตาม ID"
          },
          "response": []
        },
        {
          "name": "Delete MCP Server",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mcp/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "servers",
                "{{serverId}}"
              ]
            },
            "description": "ลบ MCP Server ตาม ID"
          },
          "response": []
        }
      ]
    }
  ]
}
